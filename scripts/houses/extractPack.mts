/**
 * Extract the political and police dynasties from the world pack into the
 * engine's own data file (src/engine/housesPackData.ts), so the game does not
 * import the pack at runtime.
 *
 *   npx tsx scripts/houses/extractPack.mts [/home/claude/world-pack]
 *
 * Only members of the dynasties are taken, with the family ties between them
 * (parent, child, spouse, sibling, grandparent). Dynasties that are branches
 * of houses the engine already has (Keane, Donnelly, the Kessler sheriffs)
 * are left to those houses.
 */
import { writeFileSync } from 'node:fs';
import { join } from 'node:path';

const root = process.argv[2] ?? '/home/claude/world-pack';
const pack = await import(join(root, 'index.ts'));
const inst = await import(join(root, 'institutions.ts'));
const SKIP = new Set(['keane', 'donnelly', 'kessler']);
const KIN = new Set(['parent', 'child', 'spouse', 'sibling', 'grandparent', 'grandchild', 'ex-spouse']);

const out: unknown[] = [];
for (const d of inst.DYNASTIES as { id: string; name: string; identity: string; powerBase: string; seatOfPower: string }[]) {
  if (SKIP.has(d.id)) continue;
  const members = (pack.ALL_PEOPLE as any[]).filter((p) => p.dynastyId === d.id);
  if (!members.length) continue;
  const ids = new Set(members.map((p) => p.id));
  out.push({
    id: d.id,
    name: d.name.replace(/^The /, '').replace(/ \(.*\)$/, ''),
    identity: d.identity,
    powerBase: d.powerBase,
    people: members.map((p) => {
      const rel = (p.relationships as { kind: string; id: string }[]).filter((r) => KIN.has(r.kind) && ids.has(r.id)).map((r) => [r.kind, r.id]);
      const o: Record<string, unknown> = {
        id: p.id, first: p.name.first, last: p.name.last, g: p.sex, by: p.birthYear, origin: p.origin, eth: p.gameEthnicity,
        office: p.office, home: p.hometown, domain: p.domain, rel,
      };
      if (p.name.maiden) o.maiden = p.name.maiden;
      if (p.nickname) o.nick = p.nickname;
      if (p.deathYear !== undefined && p.deathYear <= 1960) { o.dy = p.deathYear; o.cause = p.deathCause; }
      if (p.careerHistory?.length) o.career = p.careerHistory.map((c: { year: number; title: string }) => `${c.title} (${c.year})`).slice(-3);
      return o;
    }),
  });
}

const header = `/* Generated by scripts/houses/extractPack.mts from the world pack. Do not edit by hand. */
import type { Ethnicity } from './types';

export interface PackPerson {
  id: string;
  first: string;
  last: string;
  maiden?: string;
  nick?: string;
  g: 'M' | 'F';
  by: number;
  dy?: number;
  cause?: string;
  /** World-pack origin (finer than the engine's ethnicity). */
  origin: string;
  eth: Ethnicity;
  office: string;
  home: string;
  domain: string;
  career?: string[];
  /** Family ties inside the dynasty: [kind, other id] ("the other is my <kind>"). */
  rel: [string, string][];
}

export interface PackDynasty {
  id: string;
  name: string;
  identity: string;
  powerBase: string;
  people: PackPerson[];
}

export const PACK_DYNASTIES: PackDynasty[] = `;
const file = join(import.meta.dirname, '..', '..', 'src', 'engine', 'housesPackData.ts');
writeFileSync(file, `${header}${JSON.stringify(out, null, 1).replace(/\n\s*/g, ' ').replace(/\{ "id": "/g, '\n  { "id": "')};\n`);
console.log(`wrote ${out.length} dynasties, ${out.reduce((a: number, d: any) => a + d.people.length, 0)} people to ${file}`);
